rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (Default-Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isVerifiedSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isRoomGm(roomId) {
      return isVerifiedSignedIn() &&
        exists(/databases/$(database)/documents/rooms/$(roomId)) &&
        get(/databases/$(database)/documents/rooms/$(roomId)).data.ownerUid == request.auth.uid;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'displayName', 'updatedAt']) &&
        isValidId(data.uid) &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 48 &&
        data.updatedAt is timestamp;
    }

    function isValidRoom(data) {
      return data.keys().hasAll(['roomId', 'ownerUid', 'gmName', 'presetName', 'cols', 'rows', 'tiles', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['roomId', 'ownerUid', 'gmName', 'presetName', 'cols', 'rows', 'tiles', 'music', 'createdAt', 'updatedAt']) &&
        isValidId(data.roomId) && data.roomId.size() <= 24 &&
        isValidId(data.ownerUid) &&
        data.gmName is string && data.gmName.size() >= 1 && data.gmName.size() <= 32 &&
        data.presetName in ['blank', 'crypt', 'tavern', 'arena'] &&
        data.cols is int && data.cols >= 4 && data.cols <= 32 &&
        data.rows is int && data.rows >= 4 && data.rows <= 32 &&
        data.tiles is map && data.tiles.size() <= 1024 &&
        (!('music' in data) || data.music == null || data.music is map) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSheetMap(sheet) {
      return sheet is map &&
        sheet.keys().hasAll(['isMonster', 'hiddenFromPlayers', 'raceOrType', 'classOrRole', 'levelOrCr', 'ac', 'speed', 'initiativeBonus', 'stats', 'attacks', 'abilities', 'equipment', 'notes']) &&
        sheet.keys().hasOnly(['isMonster', 'hiddenFromPlayers', 'raceOrType', 'classOrRole', 'levelOrCr', 'ac', 'speed', 'initiativeBonus', 'stats', 'attacks', 'abilities', 'equipment', 'notes']) &&
        sheet.isMonster is bool &&
        sheet.hiddenFromPlayers is bool &&
        sheet.raceOrType is string && sheet.raceOrType.size() <= 48 &&
        sheet.classOrRole is string && sheet.classOrRole.size() <= 48 &&
        sheet.levelOrCr is string && sheet.levelOrCr.size() <= 24 &&
        sheet.ac is int && sheet.ac >= 1 && sheet.ac <= 50 &&
        sheet.speed is string && sheet.speed.size() <= 32 &&
        sheet.initiativeBonus is int && sheet.initiativeBonus >= -10 && sheet.initiativeBonus <= 30 &&
        sheet.stats is map &&
        sheet.attacks is list && sheet.attacks.size() <= 10 &&
        sheet.abilities is string && sheet.abilities.size() <= 1500 &&
        sheet.equipment is string && sheet.equipment.size() <= 1500 &&
        sheet.notes is string && sheet.notes.size() <= 1500;
    }

    function isValidMini(data, roomId) {
      return data.keys().hasAll(['id', 'roomId', 'roomOwnerUid', 'ownerUid', 'ownerName', 'name', 'format', 'x', 'z', 'rotationY', 'footprint', 'scaleMultiplier', 'fixZUp', 'showBase', 'color', 'finish', 'hp', 'maxHp', 'isPropOnly', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'roomId', 'roomOwnerUid', 'ownerUid', 'ownerName', 'name', 'format', 'builtinKind', 'assetId', 'assetName', 'remoteUrl', 'x', 'z', 'rotationY', 'footprint', 'scaleMultiplier', 'fixZUp', 'showBase', 'baseStyle', 'color', 'finish', 'hp', 'maxHp', 'isPropOnly', 'sheet', 'updatedAt']) &&
        isValidId(data.id) && data.id.size() <= 64 &&
        data.roomId == roomId &&
        isValidId(data.roomOwnerUid) &&
        isValidId(data.ownerUid) &&
        data.ownerName is string && data.ownerName.size() <= 32 &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 32 &&
        data.format in ['builtin', 'stl', 'obj', 'glb', 'gltf', 'image'] &&
        (!('assetId' in data) || (data.assetId is string && data.assetId.size() <= 128)) &&
        (!('assetName' in data) || (data.assetName is string && data.assetName.size() <= 128)) &&
        (!('remoteUrl' in data) || (data.remoteUrl is string && data.remoteUrl.size() <= 512)) &&
        (!('baseStyle' in data) || (data.baseStyle is string && data.baseStyle.size() <= 24)) &&
        data.x is number && data.z is number && data.rotationY is number &&
        data.footprint is number && data.scaleMultiplier is number &&
        data.fixZUp is bool && data.showBase is bool &&
        data.color is string && data.color.size() <= 16 &&
        data.finish is string && data.finish.size() <= 16 &&
        data.hp is int && data.hp >= 0 && data.hp <= 9999 &&
        data.maxHp is int && data.maxHp >= 1 && data.maxHp <= 9999 &&
        data.isPropOnly is bool &&
        (!('sheet' in data) || data.sheet == null || isValidSheetMap(data.sheet)) &&
        data.updatedAt is timestamp;
    }

    function isValidAnnotation(data, roomId) {
      return data.keys().hasAll(['id', 'roomId', 'ownerUid', 'kind', 'x', 'z', 'radius', 'rotationY', 'color', 'label', 'gmOnly', 'createdBy', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'roomId', 'ownerUid', 'kind', 'x', 'z', 'radius', 'rotationY', 'color', 'label', 'gmOnly', 'createdBy', 'updatedAt']) &&
        isValidId(data.id) && data.id.size() <= 64 &&
        data.roomId == roomId &&
        isValidId(data.ownerUid) &&
        data.kind in ['marker', 'circle', 'square', 'cone', 'line'] &&
        data.x is number && data.z is number && data.radius is number && data.rotationY is number &&
        data.color is string && data.color.size() <= 16 &&
        data.label is string && data.label.size() <= 48 &&
        data.gmOnly is bool &&
        data.createdBy is string && data.createdBy.size() <= 32 &&
        data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isVerifiedSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow create: if isVerifiedSignedIn() && isValidId(userId) && request.auth.uid == userId &&
        isValidUserProfile(incoming()) && incoming().uid == request.auth.uid && incoming().updatedAt == request.time;
      allow update: if isVerifiedSignedIn() && isValidId(userId) && request.auth.uid == userId &&
        isValidUserProfile(incoming()) && incoming().uid == existing().uid && incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt']);
      allow delete: if false;
    }

    match /rooms/{roomId} {
      allow get: if isVerifiedSignedIn() && isValidId(roomId);
      allow list: if isVerifiedSignedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if isVerifiedSignedIn() && isValidId(roomId) &&
        isValidRoom(incoming()) &&
        incoming().roomId == roomId &&
        incoming().ownerUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedSignedIn() && isValidId(roomId) &&
        isValidRoom(incoming()) &&
        existing().ownerUid == request.auth.uid &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().roomId == existing().roomId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['presetName', 'tiles', 'music', 'gmName', 'updatedAt']);
      allow delete: if isVerifiedSignedIn() && isValidId(roomId) && existing().ownerUid == request.auth.uid;

      match /miniatures/{miniId} {
        allow get: if isVerifiedSignedIn() && isValidId(roomId) && isValidId(miniId) && (
          isRoomGm(roomId) ||
          resource.data.ownerUid == request.auth.uid ||
          !('sheet' in resource.data) ||
          resource.data.sheet == null ||
          resource.data.sheet.hiddenFromPlayers == false
        );
        allow list: if isVerifiedSignedIn() && (
          resource.data.roomOwnerUid == request.auth.uid ||
          resource.data.ownerUid == request.auth.uid ||
          !('sheet' in resource.data) ||
          resource.data.sheet == null ||
          resource.data.sheet.hiddenFromPlayers == false
        );
        allow create: if isVerifiedSignedIn() && isValidId(roomId) && isValidId(miniId) &&
          exists(/databases/$(database)/documents/rooms/$(roomId)) &&
          isValidMini(incoming(), roomId) &&
          incoming().id == miniId &&
          incoming().updatedAt == request.time &&
          incoming().roomOwnerUid == get(/databases/$(database)/documents/rooms/$(roomId)).data.ownerUid && (
            isRoomGm(roomId) ||
            (
              !incoming().isPropOnly &&
              incoming().ownerUid == request.auth.uid &&
              incoming().ownerName != '__GM__' &&
              (!('sheet' in incoming()) || incoming().sheet == null || (!incoming().sheet.isMonster && !incoming().sheet.hiddenFromPlayers))
            )
          );
        allow update: if isVerifiedSignedIn() && isValidId(roomId) && isValidId(miniId) &&
          isValidMini(incoming(), roomId) &&
          incoming().id == existing().id &&
          incoming().roomId == existing().roomId &&
          incoming().roomOwnerUid == existing().roomOwnerUid &&
          incoming().updatedAt == request.time && (
            (
              isRoomGm(roomId) &&
              incoming().diff(existing()).affectedKeys().hasOnly(['name', 'x', 'z', 'rotationY', 'footprint', 'scaleMultiplier', 'fixZUp', 'showBase', 'baseStyle', 'color', 'finish', 'hp', 'maxHp', 'ownerName', 'ownerUid', 'isPropOnly', 'sheet', 'updatedAt'])
            ) ||
            (
              existing().ownerUid == request.auth.uid &&
              !existing().isPropOnly &&
              incoming().ownerUid == existing().ownerUid &&
              (!('sheet' in existing()) || existing().sheet == null || !existing().sheet.isMonster) &&
              (!('sheet' in incoming()) || incoming().sheet == null || (!incoming().sheet.isMonster && !incoming().sheet.hiddenFromPlayers)) &&
              incoming().diff(existing()).affectedKeys().hasOnly(['name', 'x', 'z', 'rotationY', 'hp', 'maxHp', 'sheet', 'updatedAt'])
            )
          );
        allow delete: if isVerifiedSignedIn() && isValidId(roomId) && isValidId(miniId) && isRoomGm(roomId);
      }

      match /annotations/{annotationId} {
        allow get: if isVerifiedSignedIn() && isValidId(roomId) && isValidId(annotationId) && (
          !resource.data.gmOnly || isRoomGm(roomId)
        );
        allow list: if isVerifiedSignedIn() && (
          resource.data.ownerUid == request.auth.uid || resource.data.gmOnly == false
        );
        allow create: if isVerifiedSignedIn() && isValidId(roomId) && isValidId(annotationId) &&
          isRoomGm(roomId) &&
          isValidAnnotation(incoming(), roomId) &&
          incoming().id == annotationId &&
          incoming().ownerUid == request.auth.uid &&
          incoming().updatedAt == request.time;
        allow update: if isVerifiedSignedIn() && isValidId(roomId) && isValidId(annotationId) &&
          isRoomGm(roomId) &&
          isValidAnnotation(incoming(), roomId) &&
          incoming().id == existing().id &&
          incoming().roomId == existing().roomId &&
          incoming().ownerUid == existing().ownerUid &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['kind', 'x', 'z', 'radius', 'rotationY', 'color', 'label', 'gmOnly', 'updatedAt']);
        allow delete: if isVerifiedSignedIn() && isValidId(roomId) && isValidId(annotationId) && isRoomGm(roomId);
      }
    }
  }
}
