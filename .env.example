# ==============================================================================
# RPG Acao — Variaveis de Ambiente
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND (Vercel / Vite) — prefixo obrigatorio VITE_
# ------------------------------------------------------------------------------
# URL publica do servidor Node.js (server.ts) com Express + WebSockets.
# Necessario APENAS quando o frontend esta na Vercel (Vercel nao suporta
# WebSockets persistentes nem servidor Express continuo).
# Deixe vazio se o frontend e o backend estiverem no mesmo dominio (Cloud Run,
# Render, Railway, Fly.io ou local).
# Exemplo: VITE_BACKEND_URL="https://rpg-acao-server.onrender.com"
VITE_BACKEND_URL=""

# ------------------------------------------------------------------------------
# BACKEND (server.ts — Cloud Run / Render / Railway / Fly.io)
# ------------------------------------------------------------------------------
# Porta HTTP/WebSocket (padrao: 3000)
PORT="3000"

# Origens adicionais autorizadas via CORS (separadas por virgula).
# https://rpg-action-v2.vercel.app ja esta autorizada por padrao.
ALLOWED_ORIGINS="https://rpg-action-v2.vercel.app"

# ------------------------------------------------------------------------------
# AMBIENTE AI STUDIO (injetadas automaticamente em runtime)
# ------------------------------------------------------------------------------
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
